{
  "name": "whaletrade-journal",
  "version": "1.0.0",
  "description": "",
  "main": "dist/electron/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/dev.ts",
    "dev:web": "npm --prefix frontend run dev",
    "build:server": "prisma generate --config prisma7.config.ts && tsc -p tsconfig.server.json",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "start:app": "npm run build:server && electron .",
    "dist": "npm --prefix frontend run build && npm run build:server && electron-builder",
    "test:server": "tsx --test server/test/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "build": {
    "appId": "com.yourname.tradingjournal",
    "productName": "Trading Journal",
    "files": [
      "dist/**",
      "frontend/dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "prisma/migrations",
        "to": "migrations"
      },
      {
        "from": "seed",
        "to": "seed"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "mac": {
      "target": "dir"
    }
  }
}
